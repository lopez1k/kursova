   <string notr="true">
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 10pt; color: #1F2933; }
QDialog#RegisterDialog { background: #FFFFFF; }
QLabel#lblHeader { font-size: 14pt; font-weight: 600; padding-bottom: 0px; }
QLabel#lblSubheader { color: #6B7480; padding-bottom: 8px; }
QFormLayout QLabel, QLabel { color: #5B6573; }
QLabel#lblHeader { color: #1F2933; }

QLineEdit {
    background: #FFFFFF; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 5px 8px; min-height: 22px; selection-background-color: #4A6FA5;
}
QLineEdit:hover { border-color: #A9B8CC; }
QLineEdit:focus { border-color: #4A6FA5; }

QPushButton {
    background: #F4F6F8; border: 1px solid #DDE2E8; border-radius: 4px;
    padding: 8px 18px; min-height: 20px;
}
QPushButton:hover   { background: #EAEEF3; border-color: #C9D0D9; }
QPushButton:pressed { background: #DFE5EC; }
QPushButton#btnRegister { background: #4A6FA5; border-color: #4A6FA5; color: #FFFFFF; font-weight: 600; }
QPushButton#btnRegister:hover   { background: #3F5F8F; border-color: #3F5F8F; }
QPushButton#btnRegister:pressed { background: #34507A; }
</string>
