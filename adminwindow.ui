<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AdminWindow</class>
 <widget class="QWidget" name="AdminWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1048</width>
    <height>680</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Панель Адміністратора — Оренда Авто</string>
  </property>
  <property name="windowIcon">
   <iconset resource="resources.qrc">
    <normaloff>:/img/logo.png</normaloff>:/img/logo.png</iconset>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 10pt; color: #1F2933; }
QWidget#AdminWindow { background: #F4F6F8; }

/* ---- Бічне меню ---- */
QFrame#sidebarFrame { background: #1E2430; border: none; }
QLabel#titleLabel { color: #E9EDF2; font-size: 13pt; font-weight: 600; padding: 4px 6px 2px 6px; }
QLabel#welcomeLabel { color: #9AA3B2; padding: 0 6px 18px 6px; }
QFrame#sidebarFrame QPushButton {
    background: transparent; color: #C3CAD6; border: none; border-radius: 6px;
    padding: 10px 12px; text-align: left; font-size: 11pt;
}
QFrame#sidebarFrame QPushButton:hover   { background: #2A3240; color: #FFFFFF; }
QFrame#sidebarFrame QPushButton:checked { background: #3A4559; color: #FFFFFF; }
QPushButton#btnLogout { border: 1px solid #3A4352; margin-top: 10px; }

/* ---- Фільтри ---- */
QFrame#filterFrame { background: #FFFFFF; border: 1px solid #DDE2E8; border-radius: 6px; }
QFrame#filterFrame QLabel { background: transparent; border: none; }
QComboBox {
    background: #FFFFFF; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 5px 26px 5px 8px; min-height: 22px;
}
QSpinBox, QDoubleSpinBox {
    background: #FFFFFF; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 5px 26px 5px 8px; min-height: 22px;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #A9B8CC; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus { border-color: #4A6FA5; }
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border; width: 22px;
    border: none; border-left: 1px solid #E1E5EA; background: transparent;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-position: top right; border-top-right-radius: 4px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-position: bottom right; border-bottom-right-radius: 4px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background: #EEF1F5; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none; width: 0px; height: 0px;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-bottom: 4px solid #5B6573;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none; width: 0px; height: 0px;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 4px solid #5B6573;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off, QDoubleSpinBox::up-arrow:off { border-bottom-color: #C9D0D9; }
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off, QDoubleSpinBox::down-arrow:off { border-top-color: #C9D0D9; }
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 24px; border: none; background: transparent;
}
QComboBox::down-arrow {
    image: none; width: 0px; height: 0px;
    border-left: 4px solid transparent; border-right: 4px solid transparent;
    border-top: 5px solid #5B6573;
}
QComboBox::down-arrow:on { border-top: none; border-bottom: 5px solid #5B6573; }
QComboBox QAbstractItemView {
    background: #FFFFFF; border: 1px solid #C9D0D9; outline: 0; padding: 4px;
    selection-background-color: #EEF3FA; selection-color: #1F2933;
}

/* ---- Кнопки дій з авто ---- */
QWidget#carsPage QPushButton {
    background: #F4F6F8; border: 1px solid #DDE2E8; border-radius: 4px;
    padding: 8px 16px; min-height: 20px;
}
QWidget#carsPage QPushButton:hover    { background: #EAEEF3; border-color: #C9D0D9; }
QWidget#carsPage QPushButton:pressed  { background: #DFE5EC; }
QWidget#carsPage QPushButton:disabled { background: #F4F6F8; border-color: #E6E9ED; color: #A0A8B4; }
QWidget#carsPage QPushButton:checked  { background: #4A6FA5; border-color: #4A6FA5; color: #FFFFFF; }
QLabel#lblView { color: #5B6573; }
QPushButton#btnAddCar { background: #4A6FA5; border-color: #4A6FA5; color: #FFFFFF; font-weight: 600; }
QPushButton#btnAddCar:hover   { background: #3F5F8F; border-color: #3F5F8F; }
QPushButton#btnAddCar:pressed { background: #34507A; }
QPushButton#btnAddUser {
    background: #4A6FA5; border: 1px solid #4A6FA5; border-radius: 4px;
    color: #FFFFFF; font-weight: 600; padding: 8px 18px; min-height: 20px; margin-bottom: 8px;
}
QPushButton#btnAddUser:hover   { background: #3F5F8F; border-color: #3F5F8F; }
QPushButton#btnAddUser:pressed { background: #34507A; }
QPushButton#btnDeleteUser {
    background: #FFFFFF; border: 1px solid #E8C4C0; border-radius: 4px;
    color: #B42318; font-weight: 600; padding: 8px 18px; min-height: 20px; margin-bottom: 8px;
}
QPushButton#btnDeleteUser:hover    { background: #FDF1F0; border-color: #D9A39D; }
QPushButton#btnDeleteUser:pressed  { background: #FBE7E5; }
QPushButton#btnDeleteUser:disabled { background: #F4F6F8; border-color: #E6E9ED; color: #A0A8B4; }
QPushButton#btnDeleteCar:enabled { color: #B42318; border-color: #E8C4C0; background: #FFFFFF; }
QPushButton#btnDeleteCar:enabled:hover { background: #FDF1F0; border-color: #D9A39D; }

/* ---- Картки авто (createCarCardWidget) ---- */
QListWidget#carsListWidget { background: transparent; border: none; outline: 0; }
QListWidget#carsListWidget::item,
QListWidget#carsListWidget::item:hover,
QListWidget#carsListWidget::item:selected { background: transparent; border: none; }
QFrame#carCard { background: #FFFFFF; border: 1px solid #DDE2E8; border-radius: 6px; }
QFrame#carCard:hover { border-color: #A9B8CC; }
QFrame#carCard[selected=&quot;true&quot;] { background: #F3F7FC; border: 2px solid #4A6FA5; }
QFrame#carCard QLabel { background: transparent; border: none; }
QLabel#carTitle { font-size: 11pt; font-weight: 600; }
QLabel#carMeta  { color: #5B6573; }
QFrame#carLine  { background: #E6E9ED; border: none; }
QLabel#carPrice { font-weight: 600; }
QLabel#carStatusFree { color: #2E6B2E; font-size: 9pt; font-weight: 600; }
QLabel#carStatusBusy { color: #A15C07; font-size: 9pt; font-weight: 600; }
QLabel#carStatusOff  { color: #B42318; font-size: 9pt; font-weight: 600; }

/* ---- Таблиці ---- */
QTableWidget {
    background: #FFFFFF; border: 1px solid #DDE2E8; border-radius: 6px;
    gridline-color: #E6E9ED; selection-background-color: #EEF3FA; selection-color: #1F2933;
}
QHeaderView::section {
    background: #F0F2F5; border: none; border-bottom: 1px solid #DDE2E8;
    padding: 8px 10px; font-weight: 600;
}

/* ---- Профіль ---- */
QFrame#profileCard, QFrame#passwordCard, QFrame#statsCard {
    background: #FFFFFF; border: 1px solid #DDE2E8; border-radius: 6px;
}
QLabel#profileTitle, QLabel#passwordTitle, QLabel#statsTitle { font-size: 13pt; font-weight: 600; }
QLabel#lblProfileName, QLabel#lblProfileEmail, QLabel#lblProfileRole { font-size: 11pt; }
QFrame#passwordCard QLineEdit {
    background: #FFFFFF; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 5px 8px; min-height: 22px; selection-background-color: #4A6FA5;
}
QFrame#passwordCard QLineEdit:hover { border-color: #A9B8CC; }
QFrame#passwordCard QLineEdit:focus { border-color: #4A6FA5; }
QPushButton#btnChangePassword {
    background: #4A6FA5; border: 1px solid #4A6FA5; border-radius: 4px;
    color: #FFFFFF; font-weight: 600; padding: 8px 18px; min-height: 20px; margin-top: 4px;
}
QPushButton#btnChangePassword:hover   { background: #3F5F8F; border-color: #3F5F8F; }
QPushButton#btnChangePassword:pressed { background: #34507A; }
QFrame#statTile1, QFrame#statTile2, QFrame#statTile3, QFrame#statTile4 {
    background: #F4F6F8; border: none; border-radius: 6px;
}
QFrame#statsCard QLabel[kind=&quot;value&quot;] { font-size: 16pt; font-weight: 600; color: #1F2933; background: transparent; }
QFrame#statsCard QLabel[kind=&quot;caption&quot;] { color: #6B7480; background: transparent; }

/* ---- Меню ---- */
QMenuBar { background: #FFFFFF; border: none; border-bottom: 1px solid #DDE2E8; padding: 2px 4px; }
QMenuBar::item { background: transparent; padding: 5px 10px; border-radius: 4px; }
QMenuBar::item:selected { background: #E3E8EF; }
QMenu { background: #FFFFFF; border: 1px solid #DDE2E8; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #EEF3FA; color: #1F2933; }
</string>
