  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: &quot;Segoe UI&quot;; font-size: 10pt; color: #1F2933; }
QMainWindow, QWidget#centralwidget { background: #F4F6F8; }
QMenuBar, QStatusBar { background: #F4F6F8; border: none; }

/* ---- Картка входу ---- */
QFrame#frame { background: #FFFFFF; border: 1px solid #DDE2E8; border-radius: 8px; }
QFrame#frame QLabel { background: transparent; border: none; }
QLabel#label, QLabel#label_2 { color: #5B6573; font-weight: 600; padding-left: 2px; }

/* ---- Поля ---- */
QLineEdit {
    background: #FFFFFF; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 7px 10px; min-height: 20px; selection-background-color: #4A6FA5;
}
QLineEdit:hover { border-color: #A9B8CC; }
QLineEdit:focus { border-color: #4A6FA5; }

/* ---- Кнопка входу ---- */
QPushButton#pushButton {
    background: #4A6FA5; color: #FFFFFF; border: none; border-radius: 4px;
    padding: 9px 14px; font-size: 11pt; font-weight: 600;
}
QPushButton#pushButton:hover   { background: #3F5F8F; }
QPushButton#pushButton:pressed { background: #34507A; }
QPushButton#pushButton:disabled { background: #A9B8CC; }

/* ---- Кнопка реєстрації ---- */
QPushButton#btnRegister {
    background: #FFFFFF; color: #4A6FA5; border: 1px solid #C9D0D9; border-radius: 4px;
    padding: 9px 14px; font-size: 11pt; font-weight: 600;
}
QPushButton#btnRegister:hover   { background: #EEF3FA; border-color: #A9B8CC; }
QPushButton#btnRegister:pressed { background: #DFE7F2; }
</string>
